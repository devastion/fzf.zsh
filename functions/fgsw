#!/usr/bin/env zsh
# desc: Switch to a local or remote branch

fgsw() {
  emulate -L zsh
  _fzf_require_git_work_tree || return 1

  local branch
  branch="$(
    git for-each-ref --sort=-committerdate \
      --format='%(if)%(symref)%(then)%(else)%(refname:short)%(end)' \
      refs/heads/ refs/remotes/ |
      grep . |
      _fzf --query="${*}" \
        --preview 'git log --oneline --graph --color=always -n 30 {} --' \
        --preview-window 'right,60%,nohidden'
  )" || return 1
  [[ -z "${branch}" ]] && return 1

  if ! git show-ref --verify --quiet "refs/heads/${branch}" &&
    git show-ref --verify --quiet "refs/remotes/${branch}"; then
    git switch --track "${branch}" 2> /dev/null ||
      git switch "${branch#*/}"
  else
    git switch "${branch}"
  fi
}
