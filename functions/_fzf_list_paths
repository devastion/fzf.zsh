#!/usr/bin/env zsh

_fzf_list_paths() {
  emulate -L zsh
  local kind="${1}"
  if ((${+commands[fd]})); then
    fd --print0 --type "${kind}" --hidden --follow --exclude .git
  else
    # fd prints "name", find prints "./name": strip the prefix so both agree.
    # tr swaps NUL and newline because sed works on lines.
    command find -L . -name .git -prune -o -type "${kind}" ! -path . -print0 |
      command tr '\0\n' '\n\0' | command sed 's|^\./||' | command tr '\0\n' '\n\0'
  fi
}
