#!/usr/bin/env zsh
# desc: Print the value of an exported variable

fenv() {
  emulate -L zsh
  local name
  name="$(
    print -rl -- "${(@ok)parameters[(R)*export*]}" |
      _fzf_run --query="${*}" \
        --preview 'name={}; upper=$(printf %s "$name" | tr "[:lower:]" "[:upper:]"); case "$upper" in *TOKEN*|*KEY*|*SECRET*|*PASSWORD*|*PASSWD*|*CREDENTIAL*|*AUTH*) echo "(value hidden: enter prints it, ctrl-y copies it)";; *) printenv "$name";; esac' \
        --preview-window 'right,60%,wrap,nohidden' \
        --bind "ctrl-y:execute-silent(printf %s \"\$(printenv {})\" | ${_fzf_clipcopy})+abort" \
        --header='enter print value · ctrl-y copy value'
  )" || return 1
  [[ -n "${name}" ]] || return 1
  print -r -- "${(P)name}"
}
