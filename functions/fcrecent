#!/usr/bin/env zsh
# desc: Change to a directory from the stack or zoxide

fcrecent() {
  emulate -L zsh
  local dirs
  dirs="$(
    emulate zsh
    local -a dirs=("$dirstack[@]")
    ((${+commands[zoxide]})) &&
      dirs+=("${(@f)$(zoxide query --list 2> /dev/null)}")
    dirs=("${(@u)dirs:#}")
    ((${#dirs})) || {
      print -u2 -r -- 'fcrecent: no recent directories'
      exit 1
    }
    print -rl -- "$dirs[@]"
  )" || return 1
  print -r -- "${dirs}" | _fzf_cd_into --scheme=path --tiebreak=index --query="${*}"
}
