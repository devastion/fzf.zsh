#!/usr/bin/env zsh
# desc: Print the definition of an alias or function

fdef() {
  emulate -L zsh
  local name dir target REPLY tab=$'\t'
  local -i count=0
  local -a records=()

  dir="$(mktemp -d "${TMPDIR:-/tmp}/fdef.XXXXXX")" || return 1
  {
    for name in "${(@ok)aliases}"; do
      target="${dir}/$((count += 1))"
      print -r -- "$aliases[${name}]" >| "${target}"
      records+=("${name}${tab}alias${tab}${target}")
    done
    for name in "${(@ok)galiases}"; do
      target="${dir}/$((count += 1))"
      print -r -- "$galiases[${name}]" >| "${target}"
      records+=("${name}${tab}global alias${tab}${target}")
    done
    for name in "${(@ok)functions}"; do
      [[ "${name}" == [_.+-]* ]] && continue
      target="${dir}/$((count += 1))"
      _fzf_function_file "${name}" "${target}" || continue
      records+=("${name}${tab}function${tab}${REPLY}")
    done
    ((${#records})) || return 1

    name="$(_fzf_pick_definition 'enter print definition' "${*}" "$records[@]")" || return 1
    if ((${+aliases[${name}]} || ${+galiases[${name}]})); then
      alias -L -- "${name}"
    else
      whence -f -- "${name}"
    fi
  } always {
    command rm -rf -- "${dir}"
  }
}
