#!/usr/bin/env zsh
# desc: Print the definition of an alias or function

fdef() {
  emulate -L zsh
  local name kind REPLY tab=$'\t'
  local -a records=()

  for name in "${(@ok)aliases}"; do
    records+=("${name}${tab}alias${tab}$aliases[${name}]")
  done
  for name in "${(@ok)galiases}"; do
    records+=("${name}${tab}global alias${tab}$galiases[${name}]")
  done
  for name in "${(@ok)functions}"; do
    [[ "${name}" == [_.+-]* ]] && continue
    _fzf_function_source "${name}" || continue
    records+=("${name}${tab}function${tab}${REPLY}")
  done
  ((${#records})) || return 1

  name="$(_fzf_pick_definition 'enter print definition' "${*}" "$records[@]")" || return 1
  if ((${+aliases[${name}]} || ${+galiases[${name}]})); then
    alias -L -- "${name}"
  else
    whence -f -- "${name}"
  fi
}
