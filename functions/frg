#!/usr/bin/env zsh
# desc: Search file contents and open the match

frg() {
  emulate -L zsh
  ((${+commands[rg]})) || {
    print -u2 -r -- 'frg: rg not found'
    return 127
  }

  local reload='reload:test -z {q} || { rg --vimgrep --color=always --smart-case -e {q} -- .; status=$?; test $status -eq 0 -o $status -eq 1; }'
  local selection file line
  selection="$(
    _fzf --disabled --ansi \
      --query="${*}" --delimiter=: \
      --bind "start:${reload}" --bind "change:${reload}" \
      --bind 'ctrl-o:execute(${EDITOR:-vi} +{2} -- {1})' \
      --header='enter open · ctrl-o open and keep searching'
  )" || return 1
  [[ -z "${selection}" ]] && return 1

  if [[ "${selection}" =~ '^(.*):([0-9]+):([0-9]+):' ]]; then
    file="${match[1]}"
    line="${match[2]}"
  else
    print -u2 -r -- 'frg: could not parse selected match'
    return 1
  fi
  ${=EDITOR:-vi} "+${line}" -- "${file}"
}
